// create ami category table
create table ami_category(
    lottery_id int,
    ami_category varchar
);

insert into 
    ami_category
select 
    lottery_id,
    ami_category
    
from 
    all_housing_connect_data;

update ami_category
set ami_category = case
    when ami_category = 'Applied_Income_AMI_Category_-_Extremely_Low_Income' then 'Extremely Low Income'
    when ami_category = 'Applied_Income_AMI_Category_-_Low_Income_' then 'Low Income'
    when ami_category = 'Applied_Income_AMI_Category_-_Moderate_Income_' then 'Moderate Income'
    when ami_category = 'Applied_Income_AMI_Category_-_Middle_Income' then 'Middle Income'
end;

delete from 
    ami_category
where
    ami_category is null;
    
