// create unit information
create table unit_information(
    lottery_id int,
    unit_type varchar);

insert into 
    unit_information
select 
    lottery_id,
    unit_type
from 
    all_housing_connect_data;


update unit_information
set unit_type = case
    when unit_type = 'Unit_Distribution_-_Studio' then 'Studio'
    when unit_type = 'Unit_Distribution_-_1_Bedroom' then '1 Bedroom'
    when unit_type = 'Unit_Distribution_-_2_Bedrooms_' then '2 Bedroom'
    when unit_type = 'Unit_Distribution_-_3_Bedrooms' then '3 Bedroom'
    when unit_type = 'Unit_Distribution_-_4_Bedrooms+'then '4+ Bedrooms'
end;

// table check
select 
    *
from 
    unit_information;
    
