// turned joined data into a table 
// turned join into a cte in order to update table with the pivot 
// added pivots to cte after checking that they work with dql

create or replace table all_housing_connect_data as 
 (with housing_data as 
     (select
                hcb.*,
                hcl.lottery_status_,
                hcl.lottery_start_date_,
                hcl.lottery_end_date,
                hcl.lottery_mobility_percentage_,
                hcl."Lottery_Vision/Hearing_Percentage_",
                hcl.lottery_community_board_percentage_,
                hcl."Lottery_Municipal_Employee/Military_Veteran_Percentage_",
                hcl.lottery_nycha_percentage_,
                hcl.lottery_senior_percentage
            from
                housing_connect_by_building as hcb 
            inner join
                housing_connect_by_lottery as hcl
            on 
                hcb.lottery_id = hcl.lottery_id)
        select 
            *
        from 
            housing_data
        unpivot(Value for Unit_Type in 
        ("Unit_Distribution_-_Studio", "Unit_Distribution_-_1_Bedroom", "Unit_Distribution_-_2_Bedrooms_", "Unit_Distribution_-_3_Bedrooms", "Unit_Distribution_-_4_Bedrooms+") )
        unpivot(Value2 for AMI_category in 
        ("Applied_Income_AMI_Category_-_Extremely_Low_Income", "Applied_Income_AMI_Category_-_Very_Low_Income", "Applied_Income_AMI_Category_-_Low_Income_", "Applied_Income_AMI_Category_-_Moderate_Income", "Applied_Income_AMI_Category_-_Middle_Income", "Applied_Income_AMI_Category_-_Above_Middle_Income")) 
    );
   
select 
    *
from 
    all_housing_connect_data
order by 
    lottery_id asc;
        

